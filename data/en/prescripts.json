{
  "schema_version": 1,
  "revision": 1,
  "lang": "EN",
  "items": [
    {
      "id": "867bd3c6-4f7d-5997-87fa-5b0aeadae39d",
      "text": "To… Write all text today with your left hand, including numbers.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "c87aa7c2-90c4-5637-9c35-fe4d1faa2516",
      "text": "To… Find a calendar from last year and draw an X on today’s date.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "5b350aa6-1f0f-5fce-99aa-53be4b2b7412",
      "text": "To… Lower the volume of the music you're listening to to the minimum audible level and maintain it for an hour.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "bf28dc7d-8245-5ed5-9d71-2544a3e42332",
      "text": "To… Walk into the rain without an umbrella, but allow only half your body to get wet.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "087960c7-7e07-5931-88ab-771acd340856",
      "text": "To… Remember the eye color of the third person you speak to today and draw it after sunset.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "ef00d7f1-cfad-5c1a-9780-a078cbf1df42",
      "text": "To… Randomly select a word from the dictionary and use it in conversation three times.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "0dbc51c6-f7dd-543d-b823-6ff87de8499f",
      "text": "To… Set your phone's language to one you do not recognize until midnight.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "b4978989-42fc-5f17-81f2-8ff537c52b2b",
      "text": "To… Eat a meal using your non-dominant hand.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "05fbb478-a947-5265-ba75-21f31bcfc18e",
      "text": "To… Place your favorite book upside down in a conspicuous spot on your shelf for a week.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "a5ecf1e6-44ab-547e-a908-4a0fa4e568c2",
      "text": "To… Carry a smooth stone in your pocket; rub it whenever you feel unsettled.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "8ba0729c-ed70-561a-a10e-82c57a1cd1ad",
      "text": "To… Tear up a photograph of yourself and scatter the pieces in different trash bins.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "65a92768-6f25-5e9b-8925-f5c45c475c4a",
      "text": "To… Find an empty room and say your childhood nickname out loud.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "ea8e2406-dc31-5d36-bd81-94ffefbf6034",
      "text": "To… Wash your hands with cold water and do not dry them; let the air dry them.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "e26a8bd5-6264-51d9-b268-3badbda9cb94",
      "text": "To… Refuse to use the word \"I\" today.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "2ed1d68e-41bf-5f52-915c-a4141d5eae7c",
      "text": "To… Record all blue objects in your field of vision at 2:34 PM.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "46a2bbdc-2558-55e8-88f0-7f701689cd8a",
      "text": "To… Draw a continuous, unbroken line on paper until the ink runs out.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "253fff66-a9cd-5f94-b4bd-2c0572f2c911",
      "text": "To… Smile at the first person you see today without explaining why.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "d264e8d5-a38d-524a-923d-bd61db173be6",
      "text": "To… Count from one to one hundred, but clap once whenever you reach a multiple of seven.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "09555952-b850-5d76-85c9-631e34a13118",
      "text": "To… Remember the shape of a cloud today and mimic one with your shadow at dusk.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "88468927-8b5e-5c1d-b880-5bc36076de0c",
      "text": "To… Seal a drawer with tape and promise not to open it for three days.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "d3884aa9-47e7-519f-a7fb-e1e9a167f691",
      "text": "To… Recite a poem you remember, but in reverse word order.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "87c94f69-d5d5-57e5-b1f3-4f2e98171c08",
      "text": "To… Whistle the earliest melody you can recall from memory.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "ce036b21-ee47-561f-83f5-8637be3f4016",
      "text": "To… Post a meaningless syllable on social media and do not reply to any comments.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "1155adbc-eab9-52fc-9501-cae9aa497b60",
      "text": "To… Tie your shoelaces into a complex knot that cannot be understood at a glance.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "eac11d7c-e3df-577b-9582-0943ffc4d40d",
      "text": "To… Answer questions using only monosyllabic words today.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "6e1854e9-8573-5364-b59a-09fa56f8f441",
      "text": "To… Find a spherical object, set it rolling, and follow it until it stops.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "215f6fa6-681c-51df-8f4c-6752740bcd40",
      "text": "To… Write a secret on a mirror with soap, then immediately wipe it away.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "6e9c3de2-c58b-578e-8bd4-8bd557fdcaa1",
      "text": "To… Place a glass of water in sunlight and observe the traces of evaporation.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "cc9e5485-55a2-5482-bb32-2694494b8315",
      "text": "To… Record your first breath today and try to replicate its rhythm before sleep.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "529c2862-cd15-5053-b8e0-65e7ed40e5dc",
      "text": "To… Arrange leaves into the initials of your name, then scatter them with a breath.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "60143dae-4a69-59a7-989a-5e1b27a72aa3",
      "text": "To… Touch ten surfaces of different textures with your eyes closed.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "9422a8f6-8414-5056-a935-821535d30b8e",
      "text": "To… Insert a deliberate three-second pause into conversations, regardless of topic.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "d0c8e228-8904-5a81-93a6-c73ef0893a6c",
      "text": "To… Fold a piece of paper in half seven times, no matter how thick it becomes.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "b8f6d73a-8a1a-5a49-a6a1-df49cf18b111",
      "text": "To… Do not sit down today unless absolutely necessary.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "24ca3c76-76d7-5ccc-8277-6de701f96ac2",
      "text": "To… Silently repeat a random number in your mind all day.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "e20e6944-ad6f-5dbc-9a40-1e9a485f9071",
      "text": "To… Find a place with a clear echo and say something you have never said before.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "be55db76-7272-5bd2-8999-396269c32740",
      "text": "To… Brew a hot drink with cold water and drink it.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "4e8fca98-8823-50ff-a396-966cd7f306e7",
      "text": "To… Sit in darkness for five minutes, trying to hear the faintest sound.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "2f67b98c-5235-533b-9d41-840d5a6a10c0",
      "text": "To… Delete one detail from a memory and never recall it again.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "77f86c7c-27ca-53f8-ae06-089fcb6b4beb",
      "text": "To… Retell your day's events using only opposite descriptions.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "262cdad8-c147-5394-8ec5-d40f7ed95508",
      "text": "To… Hum a tune quietly in public but do not record the melody anywhere.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "d06b58cb-a3eb-5641-b761-d41f7f777692",
      "text": "To… Set your watch five minutes fast (or slow) and live by it for the entire day.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "484091de-9a74-5016-9dfb-5cee2c30ceab",
      "text": "To… Find a set of keys, shake them, and remember their sound.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "a02477cf-a4ef-5022-9440-c4731fa4f946",
      "text": "To… Leave a single clear fingerprint on a clean surface and do not wipe it away.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "cc2c8169-fb67-5ec1-8b90-b08d902904d0",
      "text": "To… Write a sentence with a pen that is not yours, then return the pen.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "700e2fa5-4078-5e1c-af78-5ea432e0af6a",
      "text": "To… Count the corners in the room you are in and place a small object in each.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "21e8e389-b2d8-5c3c-9bad-28ccd0aae020",
      "text": "To… Do not directly refuse any requests today; respond with silence or by changing the subject.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "5d0be142-64ca-5fa5-bb84-77b0b1a53cd9",
      "text": "To… Find a bent nail and try to imagine it as a different tool.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "77f36f05-f222-5d19-a838-68bf9b396dd5",
      "text": "To… Repeat the first sentence you hear until it loses meaning.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "e7b1bb36-6b66-57e4-ac77-8ef5c014158b",
      "text": "To… Place a small piece of paper on water and watch it drift without guiding it.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "87f1e378-464e-57e0-a88f-b611d55c01a8",
      "text": "To… Remember an uncommon smell and try to recreate it in your mind.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "eca02e1b-4ea7-5c78-9ee5-fa09a902dc86",
      "text": "To… Read a passage from a book in the softest voice you can manage.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "de72c90a-d41f-5ec0-90fa-b6aebec4eefb",
      "text": "To… Carry two slips of paper in your pocket, one saying \"YES\" and one \"NO\"; draw one randomly when a decision is needed.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "d8cf5bb3-5473-5a90-9197-83ebbbd9b033",
      "text": "To… Imitate the expression of a person in a painting for one minute.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "ebac15f2-2916-5ba7-9ba5-3a9f9218dee0",
      "text": "To… Note the exact time of sunset and do something different at that time tomorrow.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "5ecffdea-4380-595e-b6ee-15cb022792a2",
      "text": "To… Sign your name with your non-dominant hand and compare it to your usual signature.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "801dbab9-5c97-5b87-bdc2-59bf2bed7f67",
      "text": "To… Count backwards from 1000 in your mind; start over whenever interrupted.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "174955b5-dc8a-5ab2-bad3-a435e06da428",
      "text": "To… Find the most distant point you can see and stare at it for thirty seconds.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "577baed9-c3d5-531a-be27-40294b586b1d",
      "text": "To… Arrange food into a simple pattern, then eat it.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "7c812101-999c-5ce5-b160-d8e0b06f8225",
      "text": "To… Stop in the middle of a staircase, neither ascending nor descending, for one minute.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "d9f6a1e3-7ca4-5114-b3ee-3472616fbf8b",
      "text": "To… Remember a specific texture and try to describe it in words at day's end.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "a85960e8-ff89-5454-80bc-e4d1adda6d8e",
      "text": "To… Breathe on glass and draw a symbol in the fog before it vanishes.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "f90446e1-1ee2-5525-b1c7-04e42a3ced24",
      "text": "To… Comb your hair backward, opposite to your usual style.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "2f9b1738-5791-5f14-a889-6611810d9c88",
      "text": "To… Clap once in a quiet place and wait for the echo to fade.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "1e15c48e-a499-5862-9902-bf568ea43915",
      "text": "To… Fold a piece of paper into the most complex shape you can conceive, then unfold it.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "5546092e-6b40-5b57-91b0-8ce9695b42e4",
      "text": "To… Assign a color in your mind to each person you meet today; do not tell them.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "74e9d558-3256-5c09-b440-8546a4107c12",
      "text": "To… Guess the time without a clock and check your accuracy at the end of the day.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "aa96b3c8-30cb-5ccb-b007-7bed8736d37c",
      "text": "To… Tap a rhythm with your foot for two minutes.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "1ebf316c-90cc-5e93-9c0e-ffb9a5247bc6",
      "text": "To… Find a shadow, stand in it until you feel a temperature change.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "ce21c589-aaa0-55cb-9042-dbcfe4295b9e",
      "text": "To… Repeat a word in your mind until it sounds foreign.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "50245f12-99c5-511b-b580-b2c06f547ab1",
      "text": "To… Arrange your eating utensils in a mirror image of their usual placement.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "05b836e2-09d5-5ff6-98bf-026e16bd8cbc",
      "text": "To… Count how many times you blink today and report the number to yourself at dusk.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "dc568496-06ef-5209-9145-3a085dc2c1b2",
      "text": "To… Look at a familiar environment with one eye closed for ten minutes.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "d4526210-a9d9-568a-9a31-8c6ff9c156a5",
      "text": "To… Mentally play a fast song at half its speed.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "67dde37e-e1a4-52b8-bd2c-eb82db080fd4",
      "text": "To… Find a hollow sound (like tapping an empty container) and remember its pitch.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "fa4a20fa-6d2a-53c1-9de6-2a785c4fc61f",
      "text": "To… Draw a closed shape with a single, unbroken line.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "fad33ba7-c8c1-5038-950d-7b6b3bdb496f",
      "text": "To… Speak only truths in conversation, but not the whole truth.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "a405952d-6d5e-5dbd-b88e-9d2cafef2350",
      "text": "To… Choose a number at the start of the day and alter your path each time you notice it.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "a30b3d27-f647-503b-82e7-1cdf93a3add8",
      "text": "To… Perform a daily task (like pouring water) in slow motion, taking at least one minute.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "1b67d664-9940-5348-8cf6-62b031547ed0",
      "text": "To… Rewrite a memory in your mind as you wish it had happened.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "70c53545-815b-50b9-b3b0-66b77463c6f8",
      "text": "To… Find a point of balance (like balancing a pen on your fingertip) and maintain it until you fail.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "64d79793-e979-5b2b-9e00-30e50874e08c",
      "text": "To… Say \"thank you\" to the last tool you use today (e.g., pen, keyboard).",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "4a3d7660-cb66-59ed-a9e9-0c69c67a43f5",
      "text": "To… Identify three objects in the dark using only touch.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "ebe2a26c-4455-5965-a80d-47ca4df41e8b",
      "text": "To… Season a meal with a combination of spices you have never used together.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "2b7598c6-4a1a-5ee9-8f9f-9519782b0e75",
      "text": "To… Silently choose a theme for the day (like \"red\" or \"circular\") and notice all related things.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "2c589a0b-bafd-5626-9c3f-fa2a79cf7352",
      "text": "To… At the end of the day, write down the last word you said today.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "74a12bd9-0ed0-526f-b7be-29cc51da870a",
      "text": "To… Find an ancient mirror (at least 30 years old). At midnight, use it to reflect moonlight, casting the gleam onto the west wall of your bedroom. Recite the first nursery rhyme you can remember aloud, while using your other hand to trace the inversepath of the light spot on the wall.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "e70cc7d1-7a77-552d-8c12-ae4989bd448d",
      "text": "To… Staple your left cuff to your right cuff. Consume your first meal of the day in this state.",
      "apply_target": true,
      "alert": false
    },
    {
      "id": "1be56b2b-2e9c-5d9b-af86-5d1fdb8d3885",
      "text": "Gears grind in flesh. The City's will is absolute.",
      "title": "[ WARNING: ABNORMALITY ]",
      "color": "#FF0000",
      "audio": "default",
      "apply_target": false,
      "alert": true
    },
    {
      "id": "a916eee9-ea31-5fc5-bcd2-c6eb2725aace",
      "text": "Do not show that you remember this melody.",
      "title": "[ LOG: SILENT ANOMALY ]",
      "color": "#7B0000",
      "audio": "default",
      "apply_target": false,
      "alert": true
    },
    {
      "id": "4a2c8b4a-f344-51a0-830d-7f964720f70f",
      "text": "It's all your fault Ishmael!!",
      "title": "【 STRONG WISH DETECTED 】",
      "color": "#FFFFFF",
      "audio": "Ahab",
      "apply_target": false,
      "alert": true
    },
    {
      "id": "3d1a6144-1037-5f2f-b5c3-57019faf56e2",
      "text": "The compass is still spinning, pointing towards that name.",
      "title": "[ LOG: ISHMAEL ]",
      "color": "#FF8200",
      "audio": "default",
      "apply_target": false,
      "alert": true
    },
    {
      "id": "059808b6-5861-5063-a6ef-a56333aa61a7",
      "text": "Is even this better than sailing without direction?",
      "title": "[ LOG: ISHMAEL ]",
      "color": "#FF8200",
      "audio": "default",
      "apply_target": false,
      "alert": true
    },
    {
      "id": "785ae640-1fee-52a9-9c7b-a4544cba78b2",
      "text": "I'm sick of blind obedience, but... I can't stop yet.",
      "title": "[ LOG: ISHMAEL ]",
      "color": "#FF8200",
      "audio": "default",
      "apply_target": false,
      "alert": true
    },
    {
      "id": "d233e5b9-c6d5-5f02-a726-0e0ac0c633d0",
      "text": "Faust knows all.",
      "title": "[ LOG: FAUST ]",
      "color": "#FF7D21",
      "audio": "default",
      "apply_target": false,
      "alert": true
    },
    {
      "id": "841e3427-ab7d-5faa-8839-fc86d1b065e0",
      "text": "The logic of this prescript falls within Faust's calculations.",
      "title": "[ LOG: FAUST ]",
      "color": "#FF7D21",
      "audio": "default",
      "apply_target": false,
      "alert": true
    },
    {
      "id": "d3f4863c-7ab8-500e-9865-db2735ee0ea7",
      "text": "Mephistopheles' engine requires more pride.",
      "title": "[ LOG: FAUST ]",
      "color": "#FF7D21",
      "audio": "default",
      "apply_target": false,
      "alert": true
    },
    {
      "id": "fdceb26d-0d7a-5c9b-8aa3-b7d1c5edb9ca",
      "text": "The loom has answered your thought.",
      "apply_target": false,
      "alert": false
    },
    {
      "id": "1e1e79e0-db43-5b75-94d9-79843fcd1199",
      "text": "The answer you seek has been written into the next prescript.",
      "apply_target": false,
      "alert": false
    },
    {
      "id": "1991a36f-942c-5a73-83ca-9c992303b8c9",
      "text": "Do not explain it yet. Let the silence finish weaving.",
      "apply_target": false,
      "alert": false
    },
    {
      "id": "7ae2c9c3-3f80-54b1-8086-f51722c90316",
      "text": "The third thought is not the answer. It is bait.",
      "apply_target": false,
      "alert": false
    },
    {
      "id": "d9277dd8-2984-538a-b879-8bc25bc14e7f",
      "text": "You already know what to do. You only deny the cost.",
      "apply_target": false,
      "alert": false
    },
    {
      "id": "bfcc27de-6eb4-5c3f-87f3-ea4bd8043391",
      "text": "Wait until the noise becomes regular.",
      "apply_target": false,
      "alert": false
    },
    {
      "id": "99e6b32a-ab49-558b-b44d-1cc666dacd8c",
      "text": "Eat noodles. Do not ask why.",
      "apply_target": false,
      "alert": false
    },
    {
      "id": "95193889-4a92-5d13-bd42-246eadd8f4f5",
      "text": "Eat something warm today.",
      "apply_target": false,
      "alert": false
    },
    {
      "id": "372760cd-963c-5314-81c1-65365fe7ee2b",
      "text": "Rice, with something salty. Your system needs stability.",
      "apply_target": false,
      "alert": false
    },
    {
      "id": "374df61b-1451-5eb3-b450-4bfa441a619f",
      "text": "Dumplings. Sealed things are safer.",
      "apply_target": false,
      "alert": false
    },
    {
      "id": "c7b1e087-869a-515e-95bc-8a4c75167a06",
      "text": "Fried food is allowed. Do not mistake it for an answer.",
      "apply_target": false,
      "alert": false
    },
    {
      "id": "9dd68f42-d327-52e7-b7ee-c55a24726147",
      "text": "Soup. This is not a day for dry decisions.",
      "apply_target": false,
      "alert": false
    }
  ],
